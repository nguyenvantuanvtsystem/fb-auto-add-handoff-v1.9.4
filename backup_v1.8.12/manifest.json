{
  "manifest_version": 3,
  "name": "FB Auto Tool - Add Scrape Group Feed AI",
  "version": "1.8.12",
  "description": "Tự động Facebook: kết bạn có lọc, đăng bài AI lên nhóm với bảng màu nền cố định/ngẫu nhiên, tương tác, cào bài và comment AI.",
  "permissions": ["storage", "downloads", "debugger"],
  "host_permissions": [
    "*://*.facebook.com/*",
    "https://api.openai.com/*",
    "https://generativelanguage.googleapis.com/*",
    "https://api.anthropic.com/*",
    "https://api.groq.com/*",
    "https://openrouter.ai/*",
    "https://api.deepseek.com/*",
    "https://api.mistral.ai/*",
    "https://*/*"
  ],
  "action": {
    "default_title": "FB Auto Add",
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["*://*.facebook.com/*"],
      "js": ["content.js", "scrape.js", "group.js", "feed.js"],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "128": "icon128.png"
  }
}
